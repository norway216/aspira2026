FROM golang:1.22-alpine AS builder

ENV GOPROXY=https://goproxy.cn,https://goproxy.io,direct
ENV GOSUMDB=off

RUN apk add --no-cache git

WORKDIR /app
COPY agent/go.mod agent/go.sum ./
RUN go mod download

COPY agent/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /embedded-agent ./cmd/agent

FROM alpine:3.20

RUN apk add --no-cache ca-certificates util-linux e2fsprogs

COPY --from=builder /embedded-agent /usr/local/bin/embedded-agent
COPY deploy/agent-config.yaml /etc/embedded-agent/config.yaml

RUN mkdir -p /var/lib/embedded-agent /var/log

ENTRYPOINT ["/usr/local/bin/embedded-agent", "-config", "/etc/embedded-agent/config.yaml"]