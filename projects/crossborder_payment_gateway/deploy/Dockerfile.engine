FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential cmake libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY engine/ ./

RUN mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make -j$(nproc)

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/payment_engine .
COPY engine/config/engine.json /app/config/engine.json

EXPOSE 9100

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD echo '{"id":"health","type":"health_check"}' | nc localhost 9100 || exit 1

CMD ["./payment_engine", "config/engine.json"]
