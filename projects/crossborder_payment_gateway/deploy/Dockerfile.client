FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY client/go.mod client/go.sum ./
RUN go mod download

COPY client/ ./

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /client .

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /client .

ENTRYPOINT ["./client"]
CMD ["--mode=payment", "--concurrency=20", "--rate=500", "--duration=30s", "--target=http://gateway:8080"]
